// Grafana Alloy configuration example for scraping sshark-api metrics
//
// This example shows how to configure Alloy to scrape metrics from sshark-api.
// Add this to your Alloy configuration to enable metrics collection.

// Discover sshark-api pods using Kubernetes service discovery
discovery.kubernetes "sshark_api_pods" {
  role = "pod"

  namespaces {
    names = ["default"] // Change to your namespace
  }

  selectors {
    role = "pod"
    label = "app.kubernetes.io/name=sshark-api"
  }
}

// Relabel discovered pods to extract metrics endpoint information
discovery.relabel "sshark_api" {
  targets = discovery.kubernetes.sshark_api_pods.targets

  // Keep only pods with scrape annotation
  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_metrics_grafana_com_scrape"]
    action        = "keep"
    regex         = "true"
  }

  // Use the metrics path from annotation
  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_metrics_grafana_com_path"]
    action        = "replace"
    target_label  = "__metrics_path__"
    regex         = "(.+)"
  }

  // Use the metrics port from annotation
  rule {
    source_labels = ["__address__", "__meta_kubernetes_pod_annotation_metrics_grafana_com_port"]
    action        = "replace"
    regex         = "([^:]+)(?::\\d+)?;(\\d+)"
    replacement   = "$1:$2"
    target_label  = "__address__"
  }

  // Add useful labels
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_component"]
    target_label  = "component"
  }
}

// Scrape metrics from discovered targets
prometheus.scrape "sshark_api" {
  targets    = discovery.relabel.sshark_api.output
  forward_to = [prometheus.remote_write.default.receiver]

  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

// Configure where to send metrics (adjust to your Prometheus/Mimir/etc endpoint)
prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write" // Change to your endpoint

    // Optional: Add authentication
    // basic_auth {
    //   username = "user"
    //   password = "pass"
    // }
  }
}

// Alternative: Use service discovery instead of pod discovery
// This discovers the sshark-api Service and uses service annotations
discovery.kubernetes "sshark_api_service" {
  role = "service"

  namespaces {
    names = ["default"] // Change to your namespace
  }

  selectors {
    role = "service"
    label = "app.kubernetes.io/name=sshark-api"
  }
}

discovery.relabel "sshark_api_from_service" {
  targets = discovery.kubernetes.sshark_api_service.targets

  rule {
    source_labels = ["__meta_kubernetes_service_annotation_metrics_grafana_com_scrape"]
    action        = "keep"
    regex         = "true"
  }

  rule {
    source_labels = ["__meta_kubernetes_service_annotation_metrics_grafana_com_path"]
    action        = "replace"
    target_label  = "__metrics_path__"
    regex         = "(.+)"
  }

  rule {
    source_labels = ["__address__", "__meta_kubernetes_service_annotation_metrics_grafana_com_port"]
    action        = "replace"
    regex         = "([^:]+)(?::\\d+)?;(\\d+)"
    replacement   = "$1:$2"
    target_label  = "__address__"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_service_name"]
    target_label  = "service"
  }
}

// Uncomment to use service-based discovery instead
// prometheus.scrape "sshark_api_from_service" {
//   targets    = discovery.relabel.sshark_api_from_service.output
